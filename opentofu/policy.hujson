{
	"groups": {
		"group:admin":   ["ksymailing@gmail.com"],
		"group:member":  ["azc2004@gmail.com", "sj92031@gmail.com"],
		"group:develop": ["deuxksy@gmail.com"],
	},

	"tagOwners": {
		"tag:https":    		["group:member", "group:develop", "group:admin", "autogroup:admin"],
		"tag:k8s":          	["tag:k8s-operator"],
		"tag:k8s-operator": 	["group:member", "group:develop", "group:admin", "autogroup:admin"],
		"tag:mobile":   		["group:member", "group:develop", "group:admin", "autogroup:admin"],
		"tag:ios":          	["group:member", "group:develop", "group:admin", "autogroup:admin"],
		"tag:android":      	["group:member", "group:develop", "group:admin", "autogroup:admin"],
		"tag:network":  		["group:member", "group:develop", "group:admin", "autogroup:admin"],
		"tag:pc":       		["group:member", "group:develop", "group:admin", "autogroup:admin"],
		"tag:windows":      	["group:member", "group:develop", "group:admin", "autogroup:admin"],
		"tag:mac":       		["group:member", "group:develop", "group:admin", "autogroup:admin"],
		"tag:linux":       		["group:member", "group:develop", "group:admin", "autogroup:admin"],
		"tag:ai":       		["group:member", "group:develop", "group:admin", "autogroup:admin"],
		"tag:kyolim":   		["group:member", "group:develop", "group:admin", "autogroup:admin"],
		"tag:oci":   	    	["group:member", "group:develop", "group:admin", "autogroup:admin"],
	},

	"nodeAttrs": [
		{
			"target": ["tag:https"],
			"attr": [
				"funnel",
				// 인터넷 사용자에게 오직 443 포트만 노출하도록 하드웨어 레벨에서 제한
				"tailscale.com/cap/funnel?ports=443",
			],
		},
		{
			"target": ["tag:https"],
			"attr":   ["funnel"],
		},
		{
			// tag:linux 서버와 tag:pc/mobile 클라이언트로부터 파일을 받을 수 있게 허용
			"target": ["tag:linux", "tag:pc", "tag:mobile", "tag:oci"],
			"attr":   ["tailscale.com/cap/file-sharing"],
		},
	],

	"acls": [
		// Aperture (AI Gateway) 접근 허용
		{
			"action": "accept",
			"src":    ["*"],
			"dst":    ["tag:ai:*"],
		},
		// 내부망 통신 허용 (Private Mesh)
		{
			"action": "accept",
			"src":    ["*"],
			"dst":    ["*:*"],
		},
	],

	"ssh": [
		{
			"action": "accept",
			"src":    ["group:admin", "group:member", "group:develop", "autogroup:admin"],
			"dst":    ["tag:network", "tag:ai", "tag:oci", "tag:k8s", "tag:linux", "autogroup:self"],
			"users":  ["autogroup:nonroot", "crong", "deck"],
		},
		// 태그 디바이스는 소유자 대신 tag로 식별 — autogroup:self와 같은 규칙에 병합 불가(API 400)라 분리
		// tag:pc 워크스테이션에서 서버와 다른 워크스테이션으로 SSH 허용
		{
			"action": "accept",
			"src":    ["tag:pc"],
			"dst":    ["tag:network", "tag:ai", "tag:oci", "tag:k8s", "tag:linux", "tag:mac", "tag:pc", "tag:windows"],
			"users":  ["autogroup:nonroot", "crong", "deck"],
		},
		// tag:mac 워크스테이션과 tag:ai Aperture 노드의 기존 서버 접근 허용
		{
			"action": "accept",
			"src":    ["tag:mac", "tag:ai"],
			"dst":    ["tag:network", "tag:ai", "tag:oci", "tag:k8s", "tag:linux"],
			"users":  ["autogroup:nonroot", "crong", "deck"],
		},
	],
}
